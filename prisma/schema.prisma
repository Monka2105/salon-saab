// Peluquería / barbería: clientes con login dual (email + celular), agenda por estilista
// y bitácora estética por cita. PostgreSQL (necesario para String[] y enums nativos).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum AppointmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Coincide con el tipo Weekday de src/config/tenant.ts
enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

enum AppointmentSource {
  WEB
  WHATSAPP
  ADMIN
}

/// Configuración del negocio. Todo campo nulo usa el valor por defecto de src/config/tenant.ts.
model Tenant {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String?
  tagline               String?
  description           String?
  phone                 String?
  address               String?
  timezone              String?
  primaryColor          String?
  accentColor           String?
  /// JSON parcial de `Terminology` (sobrescribe config/tenant.ts)
  terminology           String?
  systemPrompt          String?
  /// phone_number_id de Meta (o número propio en WhatsApp Web); enruta mensajes a este tenant
  whatsappPhoneNumberId String?  @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  services     Service[]
  staffMembers StaffMember[]
  appointments Appointment[]
}

/// Cliente o administrador. Se puede autenticar por email+contraseña y/o por celular (OTP).
model User {
  id              String   @id @default(cuid())
  name            String?
  email           String?  @unique
  /// bcrypt; null en cuentas creadas solo por celular
  passwordHash    String?
  /// Solo dígitos en formato internacional (igual que el wa_id de WhatsApp)
  phoneNumber     String?  @unique
  /// true solo tras validar un OTP: habilita que el agente de WhatsApp opere sobre este perfil
  isPhoneVerified Boolean  @default(false)
  noShowCount     Int      @default(0)
  role            Role     @default(USER)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]
  messages     Message[]
}

/// Código OTP de un solo uso enviado al celular. Se guarda solo el hash, nunca el código.
model VerificationToken {
  id         String    @id @default(cuid())
  /// Celular normalizado al que se envió el código
  identifier String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
}

model StaffMember {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  specialty String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  availability Availability[]
  timeOff      TimeOff[]

  @@index([tenantId, active])
}

/// Horario semanal regular del estilista. Varias filas por día = turno partido.
/// Un estilista sin filas usa el horario del negocio (config/tenant.ts → records.openingHours).
model Availability {
  id            String  @id @default(cuid())
  staffMemberId String
  weekday       Weekday
  /// Minutos desde medianoche en la zona horaria del negocio (540 = 09:00)
  startMinutes  Int
  /// Exclusivo; 1440 = fin del día
  endMinutes    Int

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, weekday])
}

/// Bloqueo puntual (vacaciones, cita médica…): rango absoluto [startTime, endTime).
model TimeOff {
  id            String   @id @default(cuid())
  staffMemberId String
  startTime     DateTime
  endTime       DateTime
  reason        String?
  createdAt     DateTime @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, startTime])
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  description     String?
  /// Unidades mínimas de la moneda (p. ej. centavos)
  price           Int
  durationMinutes Int
  imageUrl        String?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId, active])
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  userId         String
  serviceId      String
  /// null = "Cualquiera": el salón asigna estilista
  staffMemberId  String?
  startTime      DateTime
  /// startTime + duración del servicio; el bloque [startTime, endTime) queda ocupado
  endTime        DateTime
  source         AppointmentSource @default(WEB)
  status         AppointmentStatus @default(PENDING)
  /// Lo que pidió el cliente al reservar
  customerNotes  String?
  /// Fórmulas, máquinas, técnica: obligatorio para pasar a COMPLETED
  executionNotes String?           @db.Text
  /// 1–3 fotos del resultado (URLs del storage); obligatorio para pasar a COMPLETED
  photoUrls      String[]          @default([])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  @@index([tenantId, startTime])
  @@index([userId, startTime])
  @@index([staffMemberId, startTime])
}

/// Historial de conversación de WhatsApp (memoria del agente).
model Message {
  id          String   @id @default(cuid())
  userId      String
  /// user | assistant
  role        String
  content     String
  /// ID del mensaje de WhatsApp; único para descartar reintentos duplicados
  waMessageId String?  @unique
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
