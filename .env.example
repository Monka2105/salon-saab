# ── Base de datos (PostgreSQL) ───────────────────────────────
# Local: `docker compose up -d` levanta Postgres con estas credenciales.
DATABASE_URL="postgresql://salon:salon@localhost:5432/salon?schema=public"

# Slug del tenant por defecto (si no se define, se usa el de src/config/tenant.ts)
TENANT_SLUG=

# ── Autenticación (Auth.js v5) ───────────────────────────────
# Cadena aleatoria larga: `npx auth secret` o `openssl rand -base64 33`. Firma la sesión y los hashes OTP.
AUTH_SECRET=
# true fuera de Vercel (detrás de tu propio dominio/proxy)
AUTH_TRUST_HOST=true

# Admin inicial que crea `npm run db:seed` (contraseña ≥ 10 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── OTP por celular ──────────────────────────────────────────
# console (solo dev: imprime el código) | whatsapp-web (tu WhatsApp vía `npm run whatsapp`) | whatsapp-cloud (Meta)
OTP_CHANNEL=console
# Secreto compartido entre la web y el bot de WhatsApp Web (OTP_CHANNEL=whatsapp-web)
INTERNAL_API_SECRET=
WHATSAPP_WEB_PORT=3010
# OTP_CHANNEL=whatsapp-cloud: plantilla de categoría "Authentication" aprobada en Meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=es

# ── Fotos de resultados ──────────────────────────────────────
# Hosts permitidos para photoUrls al cerrar un servicio (coma-separados)
UPLOAD_ALLOWED_HOSTS=res.cloudinary.com

# ── IA (SDK de OpenAI; compatible con OpenRouter u otros proveedores OpenAI-compatible) ──
OPENAI_API_KEY=
# Opcional: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Opcional: sobreescribe agent.model de la configuración
AI_MODEL=

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
# Token que tú inventas y pegas en Meta > Webhooks > "Verify token"
WHATSAPP_VERIFY_TOKEN=
# Meta > App settings > Basic > App secret (valida la firma X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Token de acceso permanente (System User) con permiso whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
